# ===================================================
# WhatsApp Group Moderation Bot — Environment Config
# ===================================================
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# ===================================================

# ── Bot Settings ──
BOT_PREFIX=!
BOT_NAME=GroupGuard
BOT_TIMEZONE=Asia/Jakarta
DRY_RUN=false

# ── Database (PostgreSQL) ──
DB_HOST=postgres
DB_PORT=5432
DB_NAME=botwa
DB_USER=botwa
DB_PASSWORD=botwa_secret_password
DB_SSL=false

# ── Redis ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Dashboard / API ──
API_ENABLED=true
API_PORT=3001
API_HOST=0.0.0.0
SESSION_SECRET=your_session_secret_minimum_32_chars
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=admin123

# ── WhatsApp Session ──
# Directory where Baileys auth state is stored
WA_SESSION_DIR=./sessions

# ── Logging ──
LOG_LEVEL=info
LOG_DIR=./logs

# ── Backup ──
BACKUP_ENABLED=true
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
BACKUP_CRON=0 2 * * *

# ── Default Moderation Settings ──
DEFAULT_WARNING_LIMIT=3
DEFAULT_MUTE_DURATION=30m
DEFAULT_WARNING_RESET_DAYS=7
AUTO_KICK_ENABLED=false
AUTO_KICK_VIOLATIONS=10
PROFANITY_ENABLED=true
ANTI_SPAM_ENABLED=true
ANTI_LINK_ENABLED=true
ANTI_FLOOD_ENABLED=true
WELCOME_ENABLED=true
GOODBYE_ENABLED=true
